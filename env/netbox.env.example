# NetBox settings. Copy to env/netbox.env and replace every CHANGE_ME.
# env/netbox.env is git-ignored; never commit it.

# --- Secrets: generate once, keep them across upgrades and rebuilds ----------
#   SECRET_KEY:          openssl rand -base64 48 | tr -d '\n=/+' | cut -c1-60
#   API_TOKEN_PEPPER_1:  the same command again. Changing it later breaks
#                        every v2 API token.
SECRET_KEY=CHANGE_ME
API_TOKEN_PEPPER_1=CHANGE_ME

# --- Database (the postgres service) and Valkey --------------------------------
# These must match env/postgres.env, env/redis.env and env/redis-cache.env.
# For an external PostgreSQL, point DB_HOST at it and add DB_SSLMODE=require.
DB_HOST=postgres
DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD=CHANGE_ME
MAX_DB_WAIT_TIME=60
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PASSWORD=CHANGE_ME

# --- First boot ----------------------------------------------------------------
# A local superuser for first login and break-glass access. With SSO, set
# SKIP_SUPERUSER=true once the admin group can sign in.
SKIP_SUPERUSER=false
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=CHANGE_ME

# --- Local use -------------------------------------------------------------------
# For http://127.0.0.1:8080 with no proxy, comment out the whole
# "Behind the SSO Apache" section below and use:
#   ALLOWED_HOSTS=localhost 127.0.0.1
ALLOWED_HOSTS=netbox.example.com localhost

# --- Behind the SSO Apache at https://netbox.example.com/netbox -------------------
# Pairs with apache/netbox.conf.
BASE_PATH=netbox/
CSRF_TRUSTED_ORIGINS=https://netbox.example.com
# NetBox shares its hostname with other applications on the same Apache. If any
# of them is Django, or uses the default cookie names, the apps overwrite each
# other's CSRF and session cookies: POSTs fail with "CSRF token incorrect" and
# open tabs lose their session. Distinct names prevent that.
CSRF_COOKIE_NAME=netbox_csrftoken
SESSION_COOKIE_NAME=netbox_sessionid

# SSO: Apache (mod_auth_mellon) signs the user in and sends identity headers.
# A header's WSGI name is HTTP_ plus the header name, uppercased, with "-"
# turned into "_".
REMOTE_AUTH_ENABLED=true
REMOTE_AUTH_BACKEND=netbox.authentication.RemoteUserBackend
REMOTE_AUTH_HEADER=HTTP_X_REMOTE_USER
REMOTE_AUTH_AUTO_CREATE_USER=true
REMOTE_AUTH_USER_EMAIL=HTTP_X_USER_EMAIL
REMOTE_AUTH_USER_FIRST_NAME=HTTP_X_USERFIRSTNAME
REMOTE_AUTH_USER_LAST_NAME=HTTP_X_USER_LASTNAME
REMOTE_AUTH_GROUP_SYNC_ENABLED=true
REMOTE_AUTH_GROUP_HEADER=HTTP_X_USER_GROUPS
# Without this, group sync matches nothing: NetBox does not create a group it
# has never seen, so REMOTE_AUTH_SUPERUSER_GROUPS never applies and every SSO
# user lands with no permissions.
REMOTE_AUTH_AUTO_CREATE_GROUPS=true
# The separator inside X-User-Groups. Check what the first SSO login gets.
REMOTE_AUTH_GROUP_SEPARATOR=|
# Group names whose members become NetBox superusers. These are matched as exact
# strings, so check whether the IdP sends names or full DNs.
REMOTE_AUTH_SUPERUSER_GROUPS=netbox-admins

# --- Lifecycle plugin (read by configuration/plugins.py) -----------------------
# Cisco Support API credentials for the EoX sync. Leave both empty to enter
# lifecycle dates by hand. Docker secret files /run/secrets/cisco_client_id and
# /run/secrets/cisco_client_secret take precedence when present. To check a
# pair without syncing:
#   docker compose exec netbox /opt/netbox/venv/bin/python \
#     /opt/netbox/netbox/manage.py sync_cisco_eol --check-auth
CISCO_CLIENT_ID=
CISCO_CLIENT_SECRET=
# Minutes between automatic syncs: 10080 is weekly, 0 means the Sync button only.
CISCO_SYNC_INTERVAL_MINUTES=10080
# Internal HTTP server holding software images, e.g. http://images.internal/network.
# When set, a software version needs only a filename to get a download link.
IMAGE_BASE_URL=
