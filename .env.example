# Compose project settings. Copy to .env. Compose reads this file itself, so
# these are the only settings that can change the published port.

# Volumes are named <project>_netbox-postgres and so on. The existing 4.7
# instance runs as project netbox47; keep that name to reuse its data.
COMPOSE_PROJECT_NAME=netbox47

# Base image and plugin version, used for the local image tag.
NETBOX_VERSION=v4.7.4-5.1.1
LIFECYCLE_VERSION=0.5.0

# Address NetBox is published on: 127.0.0.1 for local use. Behind the SSO
# Apache on another host, use this host's private address, and allow the port
# from the Apache server only.
BIND_ADDRESS=127.0.0.1
NETBOX_PORT=8080
